# ═══════════════════════════════════════════════════════════════════════════════
# CLIP VAULT — Environment Variables
# Copy this file to .env and fill in all values before running the app.
# Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════


# ─── SERVER ──────────────────────────────────────────────────────────────────
# Local development port
PORT=3000

# Set to "production" on Vercel (Vercel sets this automatically)
NODE_ENV=development


# ─── AWS S3 ──────────────────────────────────────────────────────────────────
# Region your S3 bucket lives in
AWS_REGION=us-east-1

# IAM user access keys (create in AWS Console → IAM → Users → Security Credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The name of your S3 bucket (e.g. my-gaming-clips)
S3_BUCKET_NAME=

# Folder path inside the bucket where clips are stored (no leading slash)
# Default: gamingclips → files stored as gamingclips/MyClip.mp4
S3_FOLDER_PATH=


# ─── AZURE APP REGISTRATION ───────────────────────────────────────────────────
# Create at: portal.azure.com → Azure Active Directory → App Registrations → New Registration
#
# Required API permissions (Microsoft Graph, Delegated):
#   - Files.ReadWrite
#   - Files.ReadWrite.All
#   - offline_access
#
# After creating the app, copy the values below:

# Application (client) ID — shown on the app overview page
AZURE_CLIENT_ID=

# Client secret — create under Certificates & Secrets → New client secret
AZURE_CLIENT_SECRET=

# Directory (tenant) ID — shown on the app overview page
# Use "common" to support any Microsoft account (personal + work)
AZURE_TENANT_ID=


# ─── ONEDRIVE OAUTH ──────────────────────────────────────────────────────────
# The redirect URI must be registered in your Azure App under Authentication → Redirect URIs
#
# Local dev:   http://localhost:3000/api/oauth/callback
# Production:  https://your-app.vercel.app/api/oauth/callback
#
# Add BOTH URIs in Azure if you want OAuth to work in both environments.

ONEDRIVE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# Filled in AFTER completing the OAuth flow:
#   1. Start the server
#   2. Visit /api/oauth/authorize-url (or click "Connect OneDrive" in the setup panel)
#   3. Authorize in the browser
#   4. Copy the tokens shown on the callback page into the vars below

ONEDRIVE_ACCESS_TOKEN=
ONEDRIVE_REFRESH_TOKEN=


# ─── WEBHOOK ─────────────────────────────────────────────────────────────────
# A random secret string used to verify webhook notifications are genuinely
# from Microsoft. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

WEBHOOK_SECRET=


# ─── VERCEL (auto-set, do not edit) ──────────────────────────────────────────
# Vercel injects VERCEL_URL automatically in production.
# You do not need to set this manually — the backend uses it to build the
# correct webhook notification URL when calling /api/webhook/setup-onedrive.
#
VERCEL_URL=
